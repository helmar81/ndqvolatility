# Add a key for the provider selected below. Keep this file local and uncommitted.
OPENAI_API_KEY=

# Choose model IDs available to your provider/account.
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_QUICK_THINK_LLM=gpt-4o-mini
TRADINGAGENTS_DEEP_THINK_LLM=gpt-4o

# Comma-separated browser origins allowed to call this local backend.
TRADINGAGENTS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
